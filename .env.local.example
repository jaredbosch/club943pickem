# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# The Odds API (§4.1) — https://the-odds-api.com
ODDS_API_KEY=

# Kalshi referral code appended to market links in the picks UI
# (kalshi.com → account → referrals). Optional — links work without it.
NEXT_PUBLIC_KALSHI_REFERRAL_CODE=

# Random secret used to authenticate Vercel Cron requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Resend — transactional email (weekly admin report, commissioner league emails).
# The sending domain must be verified in Resend.
RESEND_API_KEY=
# From address for league emails (display name becomes "<Commissioner> via thepickempool").
EMAIL_FROM_ADDRESS=admin@thepickempool.com
# Signs unsubscribe links. Optional — falls back to CRON_SECRET.
# Changing it invalidates unsubscribe links in emails already sent.
UNSUBSCRIBE_SECRET=
